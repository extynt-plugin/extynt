# Dependencies and build output
node_modules/
.pnpm-store/
dist/
build/
*.tsbuildinfo
coverage/
.cache/

# Vendor SDKs live in the main checkout only
/SDKs

# Secrets and local runtime state (model keys, pairing tokens)
.env
.env.*
!.env.example
llm.env
session.json

# Logs and editor/OS files
*.log
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
.claude/settings.local.json

# After Effects project and binary files
*.jsxbin
*.aep
*.aepx
*.aet
*.aetx

# Local Adobe material, build artifacts, and Mac evidence
.local/adobe/
.local/artifacts/adobe/
artifacts/
extynt-macos.zip
extynt-*-macos*.tar.gz
extynt-*-macos*.tar.gz.sha256
/extynt-*-macos*/
extynt-mac-evidence/
