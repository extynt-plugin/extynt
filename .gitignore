# Mac release output (signed packages)
release-out/
*.zxp
*.pkg
*.dmg

# Signing material: certificates, keys, and the passwords that unlock them.
# make-release.sh keeps these in ~/.extynt-release, but never let a stray copy in here be committable.
*.p12
*.p8
*.password
*.mobileprovision

# Generated verification kit and the reports and exports from a real-hardware run (hundreds of MB).
docs/live-reports/
*.mogrt
extynt-*-review.zip

# Bug-scrub evidence root (harnesses, findings); local only
.bug-scrub/

# Local consolidated check logs (the check prints paths only on failure).
.check-logs/

# Repo-local venv for the pinned native and shell quality tools (pnpm setup:tools).
/.tools
__pycache__/

# chat-tests saved run traces
/tools/chat-tests/traces/

# Panel build outputs (node scripts/build-panel.ts, run by pnpm build): the bundle, its manifest and the gallery's icon table.
/apps/panel/main.js
/apps/panel/ui-manifest.json
/apps/panel/gallery-icons.js
