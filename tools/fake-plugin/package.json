{
  "name": "@extynt/fake-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A scriptable TCP fake of the extynt After Effects plugin: speaks the full native protocol so the client, the sidecar and the chat tests run without After Effects.",
  "dependencies": {
    "@extynt/decode": "workspace:*",
    "@extynt/host-native": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node ../../scripts/run-tests.ts dist/tests/*.test.js"
  }
}
