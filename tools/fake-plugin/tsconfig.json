{
  "extends": "../../tsconfig.strict.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "declaration": true,
    "composite": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "references": [
    {
      "path": "../../packages/decode"
    },
    {
      "path": "../../packages/host-native"
    }
  ],
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts"
  ]
}
