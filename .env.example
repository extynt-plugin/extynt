# extynt sidecar model settings for local development (`pnpm bridge:start`).
# Copy to .env (gitignored). Installed machines use llm.env in the per-user extynt state directory instead
# (~/Library/Application Support/extynt on macOS, %LOCALAPPDATA%\extynt on Windows).
# Real environment variables override both files.
# Bring your own model: extynt has no model of its own and sends project data only to the provider you set here.

# Primary in-panel agent model. One of:
# anthropic | openai | google | deepseek | xai | openrouter | ollama | custom | custom-anthropic | mock
# "ollama" runs a model on your own machine and needs no key. "mock" works offline and exercises the plan pipeline.
AE_LLM_PROVIDER=
# Set the key variable of the provider you chose, for example:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# XAI_API_KEY=
# OPENROUTER_API_KEY=
# For ollama, custom or custom-anthropic, also set the model and address:
# AE_LLM_MODEL=
# AE_LLM_BASE_URL=

# Optional: takes over only when the primary model fails to answer or produce a valid plan.
# AE_LLM_FALLBACK_PROVIDER=
