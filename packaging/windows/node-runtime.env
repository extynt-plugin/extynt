# Node.js runtime shipped inside the Windows bundle, so users never install Node. Official nodejs.org builds are
# Authenticode-signed by the Node.js project. The hash is from https://nodejs.org/dist/v${NODE_VERSION}/SHASUMS256.txt.
# NODE_VERSION must equal the one in packaging/macos/node-runtime.env (tests/win-bundle.test.ts checks it); bump both together.
NODE_VERSION=26.12.1
NODE_SHA256_WIN_X64=b3efd5c70cba3308ed46e7e699a9b8aac075bbc6b027fcb39c84c31acc25e2b4
