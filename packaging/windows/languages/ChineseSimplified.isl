; Simplified Chinese wizard wording for Inno Setup, written for extynt (MIT, extynt). Inno Setup does not ship a Simplified
; Chinese file; this one carries every message of the Inno Setup 6.7 message set, so Setup never falls back to English.
[LangOptions]
LanguageName=<7b80><4f53><4e2d><6587>
LanguageID=$0804
LanguageCodePage=0
DialogFontName=Microsoft YaHei UI

