# Node.js runtime shipped inside the macOS bundle, so users never install Node
# (and never need administrator rights to do so). Official nodejs.org builds are
# signed and notarized by the Node.js project. Hashes are from
# https://nodejs.org/dist/v${NODE_VERSION}/SHASUMS256.txt, the darwin .tar.xz lines (the archives the bundle ships); bump all three together.
NODE_VERSION=26.12.1
